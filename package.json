{
  "name": "cuberhyk-dev-flow",
  "version": "0.9.2",
  "description": "Multi-agent lifecycle workflow plugin with orient, brainstorm, design-system, split, decision, exploratory review, branch, changelog, distill, and review gates.",
  "type": "module",
  "bin": {
    "cuberhyk-dev-flow": "bin/dev-flow.js"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    ".opencode/",
    "commands/",
    "skills/",
    "templates/",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "gemini-extension.json",
    "docs/",
    "README.md",
    "LICENSE",
    "bin/"
  ],
  "scripts": {
    "install-plugin": "node ./bin/dev-flow.js install",
    "validate": "node ./bin/dev-flow.js validate",
    "init-project": "node ./bin/dev-flow.js init-project",
    "init-design-system": "node ./bin/dev-flow.js init-design-system",
    "validate-docs": "node ./bin/dev-flow.js validate-docs",
    "test:p1-review-gate": "node ./tests/dev-branch-review-gate.test.js",
    "test:codex-install": "node ./tests/codex-marketplace-install.test.js"
  },
  "keywords": [
    "ai-agent",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "opencode",
    "skills",
    "workflow"
  ],
  "author": "cuber-hyk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuber-hyk/dev-flow.git"
  },
  "homepage": "https://github.com/cuber-hyk/dev-flow#readme",
  "engines": {
    "node": ">=18"
  }
}
